# ── Stripe ────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret — created when you add the webhook endpoint
# at https://dashboard.stripe.com/webhooks  (point it at /api/stripe-webhook)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Resend (transactional email) ─────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxx

# Verified sender — must be on a domain you've verified in Resend
RESEND_FROM="寰宇KTV <noreply@huanyuktv.com>"

# ── License key signing ──────────────────────────────────
# 32+ byte random string. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# KEEP SECRET. The app ships with the *public* counterpart (or the same secret,
# if you're using HMAC) baked in for offline verification.
LICENSE_SIGNING_SECRET=replace_with_64_hex_chars
